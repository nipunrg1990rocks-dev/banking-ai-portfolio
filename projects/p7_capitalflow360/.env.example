# Copy to .env and edit. Never commit .env.
# Signing key for login tokens: any random string of 32+ characters, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
CF360_JWT_SECRET=
# Password shared by the synthetic demo users (trader1, mo1, settle1, recon1, risk1, checker1, checker2, admin1, trader2).
# Change it for anything reachable by other people.
CF360_DEMO_PASSWORD=Demo!2026
# Database password used by docker compose
CF360_DB_PASSWORD=cf360
# Host port for the app
CF360_PORT=8000
# Injected defects for test demonstrations only, comma-separated (D1..D6). Leave empty normally.
CF360_DEFECTS=
